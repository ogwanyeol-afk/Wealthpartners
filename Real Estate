<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>부동산 세금 간편계산기 | 오관열 세무사</title>
<style>
  :root{
    --navy:#0f2044;
    --navy2:#16305e;
    --gold:#c9a24b;
    --orange:#d97b2b;
    --red:#b3382c;
    --bg:#f5f6f8;
    --card:#ffffff;
    --text:#1c2536;
    --sub:#5b6478;
    --line:#e4e7ee;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:"Pretendard","Malgun Gothic","Apple SD Gothic Neo",sans-serif;
    background:var(--bg);
    color:var(--text);
  }
  .header{
    background:linear-gradient(135deg,var(--navy) 0%,var(--navy2) 100%);
    color:#fff;
    padding:28px 20px 22px;
    text-align:center;
    position:relative;
  }
  .header .office{
    font-size:13px;
    letter-spacing:2px;
    color:var(--gold);
    font-weight:600;
    margin-bottom:8px;
    text-transform:uppercase;
  }
  .header h1{
    margin:0 0 6px;
    font-size:26px;
    font-weight:800;
    letter-spacing:-0.5px;
  }
  .header p{
    margin:0;
    font-size:13.5px;
    color:#c7cee2;
  }
  .accent-line{
    height:5px;
    background:linear-gradient(90deg,var(--gold) 0%,var(--orange) 50%,var(--red) 100%);
  }
  .wrap{
    max-width:640px;
    margin:0 auto;
    padding:20px 16px 60px;
  }
  .tabs{
    display:flex;
    gap:8px;
    margin-bottom:18px;
  }
  .tab-btn{
    flex:1;
    padding:13px 8px;
    border:2px solid var(--navy);
    background:#fff;
    color:var(--navy);
    font-size:15px;
    font-weight:700;
    border-radius:10px;
    cursor:pointer;
    transition:all .15s ease;
  }
  .tab-btn.active{
    background:var(--navy);
    color:#fff;
  }
  .panel{display:none;}
  .panel.active{display:block;}
  .card{
    background:var(--card);
    border:1px solid var(--line);
    border-radius:14px;
    padding:20px 18px;
    margin-bottom:16px;
    box-shadow:0 2px 10px rgba(15,32,68,0.04);
  }
  .card h2{
    font-size:16px;
    margin:0 0 14px;
    color:var(--navy);
    font-weight:800;
    border-left:4px solid var(--gold);
    padding-left:10px;
  }
  .card h2 .tag{
    display:inline-block;
    font-size:11px;
    font-weight:800;
    color:#fff;
    background:var(--orange);
    border-radius:20px;
    padding:2px 9px;
    margin-left:8px;
    vertical-align:middle;
  }
  .field{
    margin-bottom:14px;
  }
  .field label{
    display:block;
    font-size:13.5px;
    font-weight:700;
    color:var(--text);
    margin-bottom:6px;
  }
  .field .hint{
    font-size:12px;
    color:var(--sub);
    font-weight:400;
    margin-left:4px;
  }
  .field input[type=number], .field input[type=text]{
    width:100%;
    padding:11px 12px;
    border:1.5px solid var(--line);
    border-radius:9px;
    font-size:15px;
    background:#fbfbfd;
  }
  .field input:focus{
    outline:none;
    border-color:var(--navy);
    background:#fff;
  }
  .field-row{
    display:flex;
    gap:10px;
  }
  .field-row .field{flex:1;}
  .seg{
    display:flex;
    flex-wrap:wrap;
    gap:6px;
  }
  .seg button{
    flex:1;
    min-width:64px;
    padding:10px 6px;
    border:1.5px solid var(--line);
    background:#fbfbfd;
    border-radius:8px;
    font-size:13px;
    font-weight:600;
    color:var(--sub);
    cursor:pointer;
  }
  .seg button.active{
    border-color:var(--navy);
    background:var(--navy);
    color:#fff;
  }
  .check-row{
    display:flex;
    align-items:center;
    gap:8px;
    padding:9px 0;
  }
  .check-row input{
    width:18px;height:18px;
  }
  .check-row label{
    font-size:13.5px;
    font-weight:600;
  }
  .calc-btn{
    width:100%;
    padding:15px;
    background:linear-gradient(90deg,var(--navy) 0%,var(--navy2) 100%);
    color:#fff;
    border:none;
    border-radius:10px;
    font-size:16px;
    font-weight:800;
    cursor:pointer;
    letter-spacing:-0.3px;
  }
  .calc-btn:active{opacity:0.85;}
  .result{
    display:none;
    margin-top:16px;
  }
  .result.show{display:block;}
  .total-box{
    background:var(--navy);
    color:#fff;
    border-radius:14px;
    padding:20px;
    text-align:center;
    margin-bottom:14px;
  }
  .total-box .label{
    font-size:13px;
    color:var(--gold);
    font-weight:700;
    letter-spacing:1px;
    margin-bottom:6px;
  }
  .total-box .amount{
    font-size:30px;
    font-weight:800;
  }
  .breakdown{
    background:#fff;
    border:1px solid var(--line);
    border-radius:12px;
    padding:6px 16px;
  }
  .b-row{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:11px 0;
    border-bottom:1px solid var(--line);
    font-size:14px;
  }
  .b-row:last-child{border-bottom:none;}
  .b-row .name{color:var(--sub);font-weight:600;}
  .b-row .val{font-weight:700;color:var(--text);}
  .b-row.sub .name{padding-left:10px;font-size:13px;}
  .b-row.deduct .val{color:var(--red);}
  .b-row.section{
    font-size:13px;
    color:var(--navy);
    font-weight:800;
    background:#f3f5fa;
    margin:6px -16px;
    padding:8px 16px;
    border-bottom:none;
  }
  .note{
    font-size:12px;
    color:var(--sub);
    line-height:1.6;
    background:#fbf7ee;
    border:1px solid #eadfc4;
    border-radius:10px;
    padding:12px 14px;
    margin-top:14px;
  }
  .note b{color:var(--red);}

  /* compare card */
  .compare-toggle{
    display:flex;
    align-items:center;
    justify-content:space-between;
    background:#fff;
    border:1px solid var(--line);
    border-radius:12px;
    padding:14px 16px;
    margin-bottom:14px;
    cursor:pointer;
  }
  .compare-toggle .l{font-size:14px;font-weight:800;color:var(--navy);}
  .compare-toggle .l span{
    display:inline-block;
    font-size:11px;
    background:var(--red);
    color:#fff;
    border-radius:20px;
    padding:2px 8px;
    margin-right:6px;
    font-weight:800;
  }
  .compare-toggle .arrow{color:var(--sub);font-size:13px;font-weight:700;}
  .compare-box{display:none;margin-top:-4px;margin-bottom:14px;}
  .compare-box.show{display:block;}
  .compare-grid{
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px;
  }
  .compare-col{
    background:#fff;
    border:1.5px solid var(--line);
    border-radius:12px;
    padding:14px;
    text-align:center;
  }
  .compare-col.now{border-color:var(--navy);}
  .compare-col.future{border-color:var(--orange);}
  .compare-col .cl{
    font-size:12px;font-weight:800;color:var(--sub);margin-bottom:6px;
  }
  .compare-col.now .cl{color:var(--navy);}
  .compare-col.future .cl{color:var(--orange);}
  .compare-col .cv{font-size:19px;font-weight:800;color:var(--text);}
  .compare-diff{
    text-align:center;
    margin-top:10px;
    font-size:13.5px;
    font-weight:700;
  }
  .compare-diff .up{color:var(--red);}
  .compare-diff .down{color:#1b7a4a;}

  /* info cards */
  .info-card{
    background:#fff;
    border:1px solid var(--line);
    border-radius:12px;
    padding:16px;
    margin-bottom:12px;
  }
  .info-card h3{
    font-size:14px;
    margin:0 0 10px;
    color:var(--navy);
    font-weight:800;
  }
  .sched-row{
    display:flex;
    justify-content:space-between;
    font-size:13px;
    padding:7px 0;
    border-bottom:1px dashed var(--line);
  }
  .sched-row:last-child{border-bottom:none;}
  .sched-row .t{font-weight:700;color:var(--text);}
  .sched-row .d{color:var(--sub);}
  .sched-table{
    width:100%;
    border-collapse:collapse;
    font-size:12.5px;
  }
  .sched-table th, .sched-table td{
    border:1px solid var(--line);
    padding:9px 6px;
    text-align:center;
  }
  .sched-table th{
    background:var(--navy);
    color:#fff;
    font-weight:700;
    font-size:12px;
    line-height:1.4;
  }
  .sched-table td:first-child{
    text-align:left;
    font-weight:700;
    color:var(--text);
    background:#f7f8fb;
  }
  .sched-table td.on{
    color:var(--navy);
    font-weight:800;
    background:#eef1f8;
  }
  .sched-table td.off{
    color:#c7cbd6;
  }
  .cap-row{
    display:flex;
    justify-content:space-between;
    font-size:13px;
    padding:6px 0;
  }
  .cap-row .k{color:var(--sub);}
  .cap-row .v{font-weight:700;}

  /* FAQ */
  .faq-item{
    border-bottom:1px solid var(--line);
  }
  .faq-item:last-child{border-bottom:none;}
  .faq-q{
    padding:14px 4px;
    font-size:14px;
    font-weight:700;
    color:var(--text);
    cursor:pointer;
    display:flex;
    justify-content:space-between;
    align-items:center;
  }
  .faq-q .plus{color:var(--gold);font-size:18px;font-weight:800;transition:transform .15s;}
  .faq-item.open .plus{transform:rotate(45deg);}
  .faq-a{
    display:none;
    padding:0 4px 16px;
    font-size:13px;
    color:var(--sub);
    line-height:1.7;
  }
  .faq-item.open .faq-a{display:block;}

  /* guide */
  .guide h3{
    font-size:15px;
    color:var(--navy);
    font-weight:800;
    margin:22px 0 8px;
  }
  .guide h3:first-child{margin-top:0;}
  .guide p{
    font-size:13.5px;
    color:var(--sub);
    line-height:1.8;
    margin:0 0 4px;
  }

  .footer{
    background:var(--navy);
    color:#c7cee2;
    text-align:center;
    padding:28px 20px 32px;
    margin-top:10px;
  }
  .footer .gold-line{
    width:40px;height:3px;background:var(--gold);
    margin:0 auto 14px;
  }
  .footer .firm{
    font-size:16px;font-weight:800;color:#fff;margin-bottom:4px;
  }
  .footer .info{
    font-size:13px;color:#aebadc;line-height:1.8;
  }
  .footer .cta{
    display:inline-block;
    margin-top:14px;
    padding:11px 22px;
    background:var(--gold);
    color:var(--navy);
    font-weight:800;
    border-radius:30px;
    font-size:13.5px;
    text-decoration:none;
  }
</style>
</head>
<body>

<div class="header">
  <div class="office">오관열 세무사 · 010.9158.4888</div>
  <h1>부동산 세금 간편계산기</h1>
  <p>취득세 · 재산세 · 종합부동산세, 2026년 기준으로 빠르게 확인해보세요</p>
</div>
<div class="accent-line"></div>

<div class="wrap">

  <div class="tabs">
    <button class="tab-btn active" onclick="switchTab('acq')">취득세 계산기</button>
    <button class="tab-btn" onclick="switchTab('hold')">보유세 계산기</button>
  </div>

  <!-- ===================== 취득세 ===================== -->
  <div class="panel active" id="panel-acq">
    <div class="card">
      <h2>취득 정보 입력</h2>

      <div class="field">
        <label>취득 원인</label>
        <div class="seg" id="acq-type">
          <button class="active" data-v="trade">매매</button>
          <button data-v="inherit">상속</button>
          <button data-v="gift">증여</button>
        </div>
      </div>

      <div class="field">
        <label>부동산 종류</label>
        <div class="seg" id="acq-ptype">
          <button class="active" data-v="house">주택</button>
          <button data-v="other">주택 외 (오피스텔·상가 등)</button>
        </div>
      </div>

      <div class="field" id="acq-count-field">
        <label>취득 후 세대 기준 총 주택 수</label>
        <div class="seg" id="acq-count">
          <button class="active" data-v="1">1주택</button>
          <button data-v="2">2주택</button>
          <button data-v="3">3주택</button>
          <button data-v="4">4주택 이상</button>
        </div>
      </div>

      <div class="field" id="acq-region-field">
        <label>지역 구분 <span class="hint">취득 당시(계약일·잔금일 등) 기준</span></label>
        <div class="seg" id="acq-region">
          <button class="active" data-v="non">비조정대상지역</button>
          <button data-v="adj">조정대상지역</button>
        </div>
      </div>
      <div class="note" id="acq-region-note" style="display:none;">
        4주택 이상은 조정·비조정 지역 구분 없이 <b>12%</b> 중과세율이 동일하게 적용됩니다.
      </div>

      <div class="field">
        <label id="acq-price-label">취득가액(실거래가) <span class="hint">원 단위로 입력</span></label>
        <input type="text" inputmode="numeric" id="acq-price" placeholder="예: 800,000,000" oninput="formatMoneyInput(this)">
      </div>

      <div class="field" id="acq-first-field">
        <div class="check-row">
          <input type="checkbox" id="acq-first">
          <label for="acq-first">생애최초 주택구입 (취득가액 12억원 이하, 소득요건 없음)</label>
        </div>
      </div>

      <div class="field" id="acq-inherit-special-field" style="display:none;">
        <div class="check-row">
          <input type="checkbox" id="acq-inherit-special">
          <label for="acq-inherit-special">무주택자의 1가구 1주택 상속 (특례세율 대상)</label>
        </div>
      </div>

      <div class="field" id="acq-gift-donor-field" style="display:none;">
        <div class="check-row">
          <input type="checkbox" id="acq-gift-donor1" checked onchange="refreshAcqVisibility()">
          <label for="acq-gift-donor1">증여자가 1세대 1주택자 (해당 주택만 소유)</label>
        </div>
        <div class="check-row">
          <input type="checkbox" id="acq-gift-family" checked onchange="refreshAcqVisibility()">
          <label for="acq-gift-family">수증자가 증여자의 배우자 또는 직계존비속</label>
        </div>
      </div>
      <div class="note" id="acq-gift-note" style="display:none;"></div>

      <div class="field" id="acq-area-field">
        <div class="check-row">
          <input type="checkbox" id="acq-area85">
          <label for="acq-area85">전용면적 85㎡ 초과 (농어촌특별세 대상)</label>
        </div>
      </div>

      <button class="calc-btn" onclick="calcAcq()">취득세 계산하기</button>
    </div>

    <div class="info-card" id="acq-rate-table">
      <h3>📋 매매(주택) 취득세율 조견표</h3>
      <div class="cap-row"><div class="k">1주택 (조정·비조정 무관)</div><div class="v">1~3%</div></div>
      <div class="cap-row"><div class="k">2주택 · 비조정대상지역</div><div class="v">1~3%</div></div>
      <div class="cap-row"><div class="k">2주택 · 조정대상지역</div><div class="v">8%</div></div>
      <div class="cap-row"><div class="k">3주택 · 비조정대상지역</div><div class="v">8%</div></div>
      <div class="cap-row"><div class="k">3주택 · 조정대상지역</div><div class="v">12%</div></div>
      <div class="cap-row"><div class="k">4주택 이상 (지역 무관)</div><div class="v">12%</div></div>
      <div class="cap-row"><div class="k">법인 (지역 무관)</div><div class="v">12%</div></div>
    </div>

    <div class="result" id="acq-result">
      <div class="total-box">
        <div class="label">예상 납부 총액</div>
        <div class="amount" id="acq-total">0원</div>
      </div>
      <div class="breakdown" id="acq-breakdown"></div>
      <div class="note">
        본 계산기는 <b>2026년 세법 기준 참고용 간편계산</b>이며, 실제 세액은 취득 시기·지분·세대 구성·감면 사후요건 등에 따라 달라질 수 있습니다. 계약 전 반드시 세무사 상담을 통해 정확한 세액을 확인하시기 바랍니다.
      </div>
    </div>
  </div>

  <!-- ===================== 보유세 ===================== -->
  <div class="panel" id="panel-hold">
    <div class="card">
      <h2>보유 정보 입력 <span class="tag">2026년 공시가격 기준</span></h2>

      <div class="field-row">
        <div class="field">
          <label>공시가격 <span class="hint">원 단위, 주택 전체 기준</span></label>
          <input type="text" inputmode="numeric" id="hold-price" placeholder="예: 900,000,000" oninput="formatMoneyInput(this)">
        </div>
        <div class="field">
          <label>본인 지분율 <span class="hint">공동명의는 %</span></label>
          <input type="number" id="hold-share" placeholder="100" value="100">
        </div>
      </div>

      <div class="field">
        <label>주택 수 구분</label>
        <div class="seg" id="hold-case">
          <button class="active" data-v="one">1세대1주택 (단독명의)</button>
          <button data-v="two">2주택</button>
          <button data-v="many">3주택 이상</button>
          <button data-v="corp">법인</button>
        </div>
      </div>

      <div class="field" id="hold-corp-count-field" style="display:none;">
        <label>법인 보유 주택 수</label>
        <div class="seg" id="hold-corp-count">
          <button class="active" data-v="2">2주택 이하</button>
          <button data-v="3">3주택 이상</button>
        </div>
      </div>

      <div class="field" id="hold-live-field">
        <div class="check-row">
          <input type="checkbox" id="hold-live" checked>
          <label for="hold-live">실거주 중 (2027년 개편안 비교 시 기준)</label>
        </div>
      </div>

      <div class="field" id="hold-age-field">
        <label>연령대 (고령자 세액공제, 1세대1주택 단독명의만 해당)</label>
        <div class="seg" id="hold-age">
          <button class="active" data-v="0">해당없음</button>
          <button data-v="20">60~65세</button>
          <button data-v="30">65~70세</button>
          <button data-v="40">70세 이상</button>
        </div>
      </div>

      <div class="field" id="hold-period-field">
        <label>보유기간 (장기보유 세액공제, 1세대1주택 단독명의만 해당)</label>
        <div class="seg" id="hold-period">
          <button class="active" data-v="0">5년 미만</button>
          <button data-v="20">5~10년</button>
          <button data-v="40">10~15년</button>
          <button data-v="50">15년 이상</button>
        </div>
      </div>

      <div class="field">
