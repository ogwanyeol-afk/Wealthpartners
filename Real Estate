function bracketCalc(base, table){
  for(const b of table){
    if(base <= b.max){
      return Math.max(0, base*b.rate - b.deduct);
    }
  }
  return 0;
}
function marginalRate(base, table){
  for(const b of table){
    if(base <= b.max) return b.rate;
  }
  return table[table.length-1].rate;
}

