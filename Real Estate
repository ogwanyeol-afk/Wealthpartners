// ===================== 취득세 계산 =====================
function stdAcqRate(price){
  const eok = price/1e8;
  if(eok <= 6) return 0.01;
  if(eok <= 9) return (eok*(2/3)-3)/100;
  return 0.03;
}

function calcAcq(){
  const type = segVal('acq-type');
  const ptype = segVal('acq-ptype');
  const price = parseMoney(document.getElementById('acq-price').value);
  if(!price || price <= 0){
    alert('취득가액을 입력해 주세요.');
    return;
  }
  const area85 = document.getElementById('acq-area85').checked;

  let rows = [];
  let tax=0, edu=0, rural=0, reduction=0;

  if(ptype === 'other'){
    let rate = 0.04;
    tax = price*0.04;
    edu = price*0.004;
    rural = price*0.002;
    rows.push(['적용세율', (rate*100).toFixed(2)+'%']);
  } else if(type === 'trade'){
    const count = segVal('acq-count');
    const adjusted = segVal('acq-region') === 'adj';
    const first = document.getElementById('acq-first').checked;
    let rate;
    let isHeavy = false;

    if(count==='1'){
      rate = stdAcqRate(price);
    } else if(count==='2'){
      if(adjusted){ rate = 0.08; isHeavy = true; }
      else rate = stdAcqRate(price);
    } else if(count==='3'){
      if(adjusted){ rate = 0.12; isHeavy = true; }
      else { rate = 0.08; isHeavy = true; }
    } else {
      rate = 0.12; isHeavy = true;
    }

    tax = price*rate;

    if(!isHeavy){
      edu = tax*0.10;
      rural = area85 ? price*0.002 : 0;
    } else {
      edu = price*0.004;
      rural = area85 ? price*(rate===0.08?0.006:0.01) : 0;
    }

    rows.push(['적용세율', (rate*100).toFixed(2)+'% ' + (isHeavy?'(다주택 중과)':'')]);

    if(count==='1' && first && price <= 12*1e8){
      reduction = tax <= 2000000 ? tax : 2000000;
    }
  } else if(type === 'inherit'){
    const special = document.getElementById('acq-inherit-special').checked;
    let rate;
    if(special){
      rate = 0.008;
      tax = price*0.008;
      edu = price*0.0016;
    } else {
      rate = 0.028;
      tax = price*0.028;
      edu = price*0.0016;
    }
    rural = area85 ? price*0.002 : 0;
    rows.push(['적용세율', (rate*100).toFixed(2)+'%' + (special?' (무주택자 1가구1주택 특례)':'')]);
  } else if(type === 'gift'){
    const adjusted = segVal('acq-region') === 'adj';
    const donor1 = document.getElementById('acq-gift-donor1').checked;
    const family = document.getElementById('acq-gift-family').checked;
    const exempt = donor1 && family;
    const heavy = adjusted && (price >= 3*1e8) && !exempt;
    let rate;
    if(heavy){
      rate = 0.12;
      tax = price*0.12;
      edu = price*0.004;
      rural = area85 ? price*0.01 : 0;
    } else {
      rate = 0.035;
      tax = price*0.035;
      edu = price*0.003;
      rural = area85 ? price*0.002 : 0;
    }
    rows.push(['적용세율', (rate*100).toFixed(2)+'%' + (heavy?' (조정지역 3억이상 중과, 증여자 기준)':(adjusted && price>=3*1e8 ? ' (중과 제외 요건 충족)':''))]);
  }

  const finalTax = Math.max(0, tax - reduction);
  const total = finalTax + edu + rural;

  let html = '';
  html += `<div class="b-row"><div class="name">취득가액</div><div class="val">${fmtWon(price)}</div></div>`;
  rows.forEach(r=>{
    html += `<div class="b-row"><div class="name">${r[0]}</div><div class="val">${r[1]}</div></div>`;
  });
  html += `<div class="b-row"><div class="name">취득세(본세)</div><div class="val">${fmtWon(tax)}</div></div>`;
  if(reduction>0){
    html += `<div class="b-row deduct"><div class="name">생애최초 감면</div><div class="val">-${fmtWon(reduction)}</div></div>`;
  }
  html += `<div class="b-row"><div class="name">지방교육세</div><div class="val">${fmtWon(edu)}</div></div>`;
  if(rural>0){
    html += `<div class="b-row"><div class="name">농어촌특별세</div><div class="val">${fmtWon(rural)}</div></div>`;
  }

  document.getElementById('acq-breakdown').innerHTML = html;
  document.getElementById('acq-total').textContent = fmtWon(total);
  document.getElementById('acq-result').classList.add('show');
  document.getElementById('acq-result').scrollIntoView({behavior:'smooth', block:'nearest'});
}

