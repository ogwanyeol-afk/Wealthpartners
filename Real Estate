  {max:6*1e8, rate:0.007, deduct:600000},
  {max:12*1e8, rate:0.01, deduct:2400000},
  {max:25*1e8, rate:0.02, deduct:14400000},
  {max:50*1e8, rate:0.03, deduct:39400000},
  {max:94*1e8, rate:0.04, deduct:89400000},
  {max:Infinity, rate:0.05, deduct:183400000}
];
// 2027 개편안(정부안, 근사)
const CT_2027_GENERAL = [
  {max:3*1e8, rate:0.005, deduct:0},
  {max:6*1e8, rate:0.007, deduct:600000},
  {max:12*1e8, rate:0.013, deduct:4200000},
  {max:25*1e8, rate:0.015, deduct:6600000},
  {max:50*1e8, rate:0.02, deduct:19100000},
  {max:94*1e8, rate:0.027, deduct:54100000},
  {max:Infinity, rate:0.035, deduct:129300000}
];
const CT_2027_HEAVY = [
  {max:3*1e8, rate:0.005, deduct:0},
  {max:6*1e8, rate:0.007, deduct:600000},
  {max:12*1e8, rate:0.013, deduct:4200000},
  {max:25*1e8, rate:0.02, deduct:12600000},
  {max:50*1e8, rate:0.03, deduct:37600000},
  {max:94*1e8, rate:0.04, deduct:87600000},
  {max:Infinity, rate:0.05, deduct:181600000}
];

function computeHoldSet(price, share, c, corpCount, live, ageRate, periodRate, cityArea, mode){
  // mode: 'now' or '2027'
  const shareRatio = share/100;

  // ---- 재산세 (2026 현행, 개편 대상 아님) ----
  let ptRatio, ptTable;
  if(c==='one' && price <= 9*1e8){
    ptTable = PT_SPECIAL;
    if(price <= 3*1e8) ptRatio = 0.43;
    else if(price <= 6*1e8) ptRatio = 0.44;
    else ptRatio = 0.45;
  } else {
    ptTable = PT_STD;
    ptRatio = 0.60;
  }
  const ptBase = price * ptRatio;
  const ptTaxFull = bracketCalc(ptBase, ptTable);
  const cityTaxFull = cityArea ? ptBase*0.0014 : 0;
  const ptEduFull = ptTaxFull*0.20;
  const ptTotalFull = ptTaxFull + cityTaxFull + ptEduFull;
  const ptTotal = ptTotalFull * shareRatio;

  // ---- 종부세 ----
  let deduction, ctTable, ctRate=null, fmvRatio;
  const isCorp = (c==='corp');

  if(mode==='now'){
    fmvRatio = 0.6;
    if(c==='one') deduction = 12*1e8;
    else if(isCorp) deduction = 0;
    else deduction = 9*1e8;
    ctTable = (c==='many') ? CT_HEAVY : CT_GENERAL;
  } else {
    fmvRatio = 0.7;
    if(c==='one') deduction = live ? 14*1e8 : 9*1e8;
    else if(isCorp) deduction = 0;
    else deduction = 4*1e8;
    ctTable = (c==='many') ? CT_2027_HEAVY : CT_2027_GENERAL;
  }

  const shareValue = price * shareRatio;
  let ctBase = Math.max(0, shareValue - deduction) * fmvRatio;
  let ctTax = 0;

  if(isCorp){
    ctRate = (corpCount==='3') ? 0.05 : 0.027;
    ctTax = ctBase * ctRate;
  } else {
    ctTax = bracketCalc(ctBase, ctTable);
  }

  // 재산세 공제(이중과세 조정) 근사: 종부세 과세표준 x 45% x 재산세 표준세율
  let propertyCredit = 0;
  if(ctBase > 0){
    const rRate = marginalRate(ptBase, PT_STD);
    propertyCredit = ctBase * 0.45 * rRate;
    ctTax = Math.max(0, ctTax - propertyCredit);
  }

  // 세액공제 (1세대1주택 단독명의만)
  let deductRate = 0, taxCredit = 0;
  if(c==='one'){
    deductRate = Math.min(0.8, ageRate + periodRate);
    taxCredit = ctTax * deductRate;
    if(mode==='2027'){
      taxCredit = Math.min(taxCredit, 8000000);
    }
  }
  const ctDecided = ctTax - taxCredit;
  const ctRural = ctDecided * 0.2;
  const ctTotal = ctDecided + ctRural;

  return {
    ptBase, ptTaxFull, cityTaxFull, ptEduFull, ptTotalFull, ptTotal,
    deduction, ctBase, ctTax0: (ctTax+taxCredit+propertyCredit), propertyCredit, ctTax, deductRate, taxCredit, ctDecided, ctRural, ctTotal,
    grandTotal: ptTotal + ctTotal
  };
}

let lastHoldInput = null;

function calcHold(){
  const price = parseMoney(document.getElementById('hold-price').value);
  if(!price || price <= 0){
    alert('공시가격을 입력해 주세요.');
    return;
  }
  const shareInput = parseFloat(document.getElementById('hold-share').value);
  const share = (shareInput>0 && shareInput<=100) ? shareInput : 100;
  const c = segVal('hold-case');
  const corpCount = segVal('hold-corp-count');
  const live = document.getElementById('hold-live').checked;
  const ageRate = parseInt(segVal('hold-age'))/100;
  const periodRate = parseInt(segVal('hold-period'))/100;
  const cityArea = document.getElementById('hold-city').checked;

  lastHoldInput = {price, share, c, corpCount, live, ageRate, periodRate, cityArea};

  const r = computeHoldSet(price, share, c, corpCount, live, ageRate, periodRate, cityArea, 'now');

  let html = '';
  html += `<div class="b-row section">재산세 (지분 ${share}% 반영)</div>`;
  html += `<div class="b-row"><div class="name">과세표준(전체)</div><div class="val">${fmtEok(r.ptBase)}</div></div>`;
  html += `<div class="b-row"><div class="name">재산세 본세(전체)</div><div class="val">${fmtWon(r.ptTaxFull)}</div></div>`;
  if(cityArea) html += `<div class="b-row sub"><div class="name">도시지역분(전체)</div><div class="val">${fmtWon(r.cityTaxFull)}</div></div>`;
  html += `<div class="b-row sub"><div class="name">지방교육세(전체)</div><div class="val">${fmtWon(r.ptEduFull)}</div></div>`;
  html += `<div class="b-row"><div class="name">재산세 합계(본인분)</div><div class="val">${fmtWon(r.ptTotal)}</div></div>`;

  html += `<div class="b-row section">종합부동산세 (본인 지분 기준)</div>`;
  if(r.ctBase <= 0){
    html += `<div class="b-row"><div class="name">과세표준</div><div class="val">0원 (공제금액 이하)</div></div>`;
    html += `<div class="b-row"><div class="name">종부세</div><div class="val">0원</div></div>`;
  } else {
    html += `<div class="b-row"><div class="name">기본공제</div><div class="val">${fmtEok(r.deduction)}</div></div>`;
    html += `<div class="b-row"><div class="name">과세표준</div><div class="val">${fmtEok(r.ctBase)}</div></div>`;
    html += `<div class="b-row"><div class="name">산출세액</div><div class="val">${fmtWon(r.ctTax0)}</div></div>`;
    if(r.propertyCredit>0){
      html += `<div class="b-row deduct"><div class="name">재산세 공제(이중과세 조정)</div><div class="val">-${fmtWon(r.propertyCredit)}</div></div>`;
    }
    if(r.taxCredit>0){
      html += `<div class="b-row deduct"><div class="name">세액공제 (${Math.round(r.deductRate*100)}%)</div><div class="val">-${fmtWon(r.taxCredit)}</div></div>`;
    }
    html += `<div class="b-row sub"><div class="name">결정세액</div><div class="val">${fmtWon(r.ctDecided)}</div></div>`;
    html += `<div class="b-row sub"><div class="name">농어촌특별세</div><div class="val">${fmtWon(r.ctRural)}</div></div>`;
    html += `<div class="b-row"><div class="name">종부세 합계</div><div class="val">${fmtWon(r.ctTotal)}</div></div>`;
  }

  document.getElementById('hold-breakdown').innerHTML = html;
  document.getElementById('hold-total').textContent = fmtWon(r.grandTotal);
  document.getElementById('hold-result').classList.add('show');

  // reset compare box until re-opened
  document.getElementById('compare-box').classList.remove('show');
  document.getElementById('compare-arrow').textContent = '펼치기 ▾';

  document.getElementById('hold-result').scrollIntoView({behavior:'smooth', block:'nearest'});
}

function toggleCompare(){
  const box = document.getElementById('compare-box');
  const arrow = document.getElementById('compare-arrow');
  if(!lastHoldInput){ return; }
  const isShown = box.classList.contains('show');
  if(isShown){
    box.classList.remove('show');
    arrow.textContent = '펼치기 ▾';
    return;
  }
  box.classList.add('show');
  arrow.textContent = '접기 ▴';

  const {price, share, c, corpCount, live, ageRate, periodRate, cityArea} = lastHoldInput;
  const now = computeHoldSet(price, share, c, corpCount, live, ageRate, periodRate, cityArea, 'now');
  const future = computeHoldSet(price, share, c, corpCount, live, ageRate, periodRate, cityArea, '2027');

  document.getElementById('cmp-now').textContent = fmtWon(now.grandTotal);
  document.getElementById('cmp-future').textContent = fmtWon(future.grandTotal);

  const diff = future.grandTotal - now.grandTotal;
  const pct = now.grandTotal>0 ? (diff/now.grandTotal*100) : 0;
  const diffEl = document.getElementById('cmp-diff');
  if(Math.abs(diff) < 1000){
    diffEl.innerHTML = '2026년과 유사한 수준으로 예상됩니다';
  } else if(diff > 0){
    diffEl.innerHTML = `<span class="up">▲ ${fmtWon(diff)} 증가 (약 ${pct.toFixed(1)}%)</span>`;
  } else {
    diffEl.innerHTML = `<span class="down">▼ ${fmtWon(Math.abs(diff))} 감소 (약 ${Math.abs(pct).toFixed(1)}%)</span>`;
  }
}

